# This repo's gitignore. Shouldn't be symlinked anywhere
.vscode
*.log
.DS_Store
.aider*
*.pyc
__pycache__

.config/ghostty/override_config
# They should be installed in the system using Leader + I inside tmux
.config/tmux/plugins
*_secret
# Machine-local overlays (git, jj, mise, brew). See Documentation/machine-overrides.md.
# Un-ignore directories first; otherwise *.example under /overrides/** stays ignored.
/overrides/**
!/overrides/
!/overrides/*/
!/overrides/.gitkeep
!/overrides/*/*.example

# Legacy paths (pre-overrides/ tree); keep ignoring in case a checkout still has them.
.config/jj/repos/
.config/jj/conf.d/
.config/git/

# Micro writes themes, plugins, syntax files, backups, and buffers into its config dir.
.config/micro/backups/
.config/micro/buffers/
.config/micro/colorschemes/
.config/micro/plug/
.config/micro/syntax/
/micro/
!/micro/*.json
**/repos/

# Pi
AI/.pi/agent/auth.json
AI/.pi/agent/*.bak
AI/.pi/agent/sessions/
AI/.pi/agent/npm/
AI/.pi/agent/git/

# Opencode
.config/opencode/*
!.config/opencode/tui.jsonc
!.config/opencode/opencode.json
!.config/opencode/agent/
!.config/opencode/agent/*.md
!.config/opencode/package.json
!.config/opencode/plugins/
!.config/opencode/plugins/**
.config/opencode/plugins/herdr-agent-state.js
*package-lock.json

.config/cheat/cheatsheets/community/
codebook.toml
