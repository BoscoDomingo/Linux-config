{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "toolInputPreviewMaxLength": 400,
  "toolTextSummaryMaxLength": 120,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_dsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/credentials": "deny",
      "~/.config/gcloud/*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/agent/*": "allow",
      "~/.local/share/mise/installs/pi/*": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "module_report": "allow",
    "read_symbol": "allow",
    "read_enclosing": "allow",
    "ast_grep_search": "allow",
    "ast_grep_outline": "allow",
    "ast_grep_dump": "allow",
    "ast_dump": "allow",
    "lsp_diagnostics": "allow",
    "lens_diagnostics": "allow",
    "todo": "allow",
    "mem_save": "allow",
    "mem_save_prompt": "allow",
    "mem_session_summary": "allow",
    "mem_session_start": "allow",
    "mem_session_end": "allow",
    "mem_capture_passive": "allow",
    "mem_update": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "test": "allow",
      "test *": "allow",
      "printf": "allow",
      "printf *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "head": "allow",
      "head *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current": "allow",
      "git branch --list": "allow",
      "git branch --list *": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "curl *|*sh*": "deny",
      "wget *|*sh*": "deny"
    },
    "write": "ask",
    "edit": "ask",
    "ast_grep_replace": "ask",
    "lsp_navigation": "ask",
    "web_search": "ask",
    "fetch_content": "ask",
    "get_search_content": "allow",
    "agent_browser": "ask",
    "mcp": "ask",
    "skill": {
      "*": "allow",
      "speak-caveman": "allow",
      "caveman": "allow",
      "lsp-navigation": "allow",
      "ast-grep": "allow"
    }
  }
}
