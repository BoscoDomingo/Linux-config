	"[go.mod]": {
		"editor.defaultFormatter": "golang.go"
	},
	// mise owns the Go tools (see .config/mise/config.toml); letting the
	// extension `go install` them puts binaries in the versioned GOBIN, where
	// the next Go upgrade orphans them. Update with `mise upgrade` instead.
	"go.toolsManagement.autoUpdate": false,
	// The extension looks for a bare name in $GOBIN, then $GOPATH/bin, then
	// PATH. A file in ~/go/bin thus hides the mise tool.
	// scripts/link-go-tools keeps ~/go/bin correct.
	"go.alternateTools": {
		"go": "~/.local/share/mise/installs/go/latest/bin/go",
		"customFormatter": "golangci-lint",
		// mise ships the v2 CLI as plain `golangci-lint`.
		"golangci-lint-v2": "golangci-lint"
	},
	"go.formatTool": "custom",
	"go.formatFlags": ["fmt", "--stdin"],
	// The v2 name pins the v2 output flags. The plain name makes the extension
	// read the version from the binary, and it sends v1 flags if it cannot read
	// that version. So this deviates from the manual-install setup that
	// https://golangci-lint.run/docs/welcome/integrations/ recommends.
	"go.lintTool": "golangci-lint-v2",
	"go.lintFlags": ["--path-mode=abs", "--fast-only"],
	"gopls": {
		"ui.semanticTokens": true,
		// "formatting.gofumpt": true,
		"ui.navigation.importShortcut": "Definition",
		"ui.diagnostic.analysisProgressReporting": true
	},
	"go.inlayHints.assignVariableTypes": true,
	"go.inlayHints.compositeLiteralFields": true,
	"go.inlayHints.compositeLiteralTypes": true,
	"go.inlayHints.constantValues": true,
	"go.inlayHints.functionTypeParameters": true,
	"go.inlayHints.parameterNames": true,
	"go.inlayHints.rangeVariableTypes": true,
	"go.inlayHints.ignoredError": true,
	"go.hideErrorCases.errorCasesOpacity": 0.6,
	"go.disableConcurrentTests": true,
	"go.editorContextMenuCommands": {
		"removeTags": true
	},
	"lowlightgoerrors.MediumOpacity": "0.65",
	"lowlightgoerrors.LowOpacity": "0.3",

