	// MARK: Themes/tokens
	"editor.tokenColorCustomizations": {
		"[*Light*]": {
			"textMateRules": [
				{
					"scope": "ref.matchtext",
					"settings": {
						"foreground": "#000"
					}
				}
			]
		},
		"[*Dark*]": {
			"textMateRules": [
				{
					"scope": "ref.matchtext",
					"settings": {
						"foreground": "#fff"
					}
				}
			]
		},
		"[Default Dark*]": {
			"textMateRules": [
				{
					"scope": ["string", "string.quoted.docstring.multi.python"],
					"settings": {
						"foreground": "#ffb06a"
					}
				},
				{
					"scope": "comment",
					"settings": {
						"foreground": "#858585"
					}
				},
				{
					"scope": ["keyword", "keyword.control"],
					"settings": {
						"foreground": "#e475db"
					}
				}
			]
		},
		"[Andromeda*]": {
			"textMateRules": [
				{
					"scope": [
						"keyword",
						"storage",
						"storage.type",
						"storage.modifier",
						"keyword.control",
						"keyword.operator.new",
						"variable.language.this"
					],
					"settings": {
						"foreground": "#fd68fd",
						"fontStyle": "bold"
					}
				},
				{
					"scope": ["meta"],
					"settings": {
						"foreground": "#e1e1e1f0"
					}
				},
				{
					"scope": ["meta.object-literal.key"],
					"settings": {
						"foreground": "#eeeeee"
					}
				},
				{
					"scope": [
						"entity.name.type",
						"support.class",
						"support.variable",
						"support"
					],
					"name": "Classes, interfaces, etc",
					"settings": {
						"foreground": "#f7feaa"
					}
				},
				{
					"scope": [
						"variable.other.property",
						"variable.other.object.property",
						"variable.object.property",
						"variable.other.readwrite.ts"
					],
					"name": "Object and variable declarations, extracted variables when not declared on that line and properties which are objects (e.g. process.env)",
					"settings": {
						"foreground": "#00fffb"
					}
				},
				{
					"scope": [
						"variable.other.enummember",
						"variable.other.constant.property.ts"
					],
					"name": "Enum members, constants in interface and class declarations and this.<prop> or process.env.<prop>",
					"settings": {
						"foreground": "#0c93a5"
					}
				},
				{
					"scope": [
						"variable.other.constant",
						"variable.other.constant.object.ts",
						"variable.other.constant.ts"
					],
					"name": "Declared constants",
					"settings": {
						"foreground": "#3e9d7c"
					}
				},
				{
					"scope": ["constant"],
					"name": "Numbers and booleans",
					"settings": {
						"foreground": "#F39C12"
					}
				},
				{
					"scope": ["variable.parameter"],
					"settings": {
						"foreground": "#ffb06a"
					}
				},
				{
					"scope": ["support.type"],
					"settings": {
						"foreground": "#19c2ff"
					}
				},
				{
					"scope": [
						"comment",
						"comment.block.documentation",
						"comment.line.documentation"
					],
					"settings": {
						"fontStyle": "italic",
						"foreground": "#c0c09a8e"
					}
				}
			]
		},
		"[Shades of Purple]": {
			"textMateRules": [
				{
					"scope": ["entity.name.function"],
					"settings": {
						"foreground": "#fbe600"
					}
				},
				{
					"scope": ["support.type.primitive"],
					"settings": {
						"foreground": "#ff00dd"
					}
				}
			]
		},
		"textMateRules": []
	},

