{
    "workbench.startupEditor": "readme",
    "workbench.commandPalette.history": 40,
    "workbench.colorTheme": "Andromeda Bordered",
    "workbench.iconTheme": "bearded-icons",
    "workbench.settings.applyToAllProfiles": [
        "editor.formatOnSave",
        "editor.defaultFormatter",
        "todo-tree.highlights.highlightDelay",
        "todo-tree.general.tags",
        "files.eol"
    ],
    "settingsSync.ignoredSettings": [
        "editor.fontSize",
        "terminal.integrated.fontSize",
        "debug.console.fontSize",
        "editor.minimap.scale",
        "terminal.integrated.fontFamily"
    ],
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.eol": "\n",
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "editor.fontFamily": "Maple Mono v6 Ligaturised NF,FragmentMono Nerd Font,Consolasligaturizedv2 NF,ConsolasLigaturizedV3 Nerd Font,'72Monospace Nerd Font','FiraCode+Inconsolata NF g','0xProto v2 Ligaturised NF','0xProto v1.6 Ligaturised NF','72 Monospace',Code New Roman NF Ligaturized,'FiraCode+Inconsolata NF',NotoSansM Nerd Font,InconsolataGo Nerd Font,SF Mono Ligatures,Consolas,monospace",
    "editor.fontSize": 13,
    "editor.fontWeight": "normal",
    "editor.fontVariations": true,
    "editor.fontLigatures": true,
    "debug.console.fontSize": 13,
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font,GeistMono Nerd Font,ConsolasLigaturizedV3 Nerd Font,Consolasligaturizedv2 NF,monospace",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.gpuAcceleration": "auto",
    "terminal.integrated.hideOnStartup": "whenEmpty",
    "terminal.integrated.enableImages": true,
    "terminal.integrated.altClickMovesCursor": true,
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Ubuntu (WSL)": {
            "path": "ubuntu.exe"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash"
        }
    },
    "terminal.integrated.defaultProfile.linux": "zsh",
    "editor.indentSize": "tabSize",
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.trimAutoWhitespace": true,
    "editor.insertSpaces": false,
    "editor.autoClosingBrackets": "always",
    "editor.semanticHighlighting.enabled": true,
    "editor.suggestSelection": "first",
    "editor.guides.bracketPairs": "active",
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "editor.mouseWheelZoom": false,
    "editor.inlineSuggest.enabled": true,
    "editor.quickSuggestions": {
        "other": "inline",
        "comments": false,
        "strings": "inline"
    },
    "editor.suggest.localityBonus": true,
    "editor.quickSuggestionsDelay": 5,
    "editor.suggestOnTriggerCharacters": true,
    "editor.suggest.preview": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.codeActionsOnSave": {
        "source.addMissingImports": "explicit",
        "source.organizeImports.biome": "explicit",
        "source.fixAll": "explicit",
        "source.formatDocument": "explicit"
    },
    "editor.defaultFormatter": "biomejs.biome",
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.unusedImports": "explicit",
        }
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[dockercompose]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[terraform]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.tabSize": 2
    },
    "[terraform-vars]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "hashicorp.terraform"
    },
    "[dotenv]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "[sql]": {
        "editor.defaultFormatter": "mtxr.sqltools"
    },
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[xml]": {
        "editor.defaultFormatter": "mikeburgh.xml-format"
    },
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "editor.codeActionsOnSave": [
            "source.organizeImports"
        ]
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go"
    },
    "[go.mod]": {
        "editor.defaultFormatter": "golang.go"
    },
    "go.alternateTools": {
        "go": "~/.local/share/mise/installs/go/latest/bin/go",
        // "customFormatter": "golangci-lint"
    },
    // "go.formatTool": "custom",
    // "go.formatFlags": [
    //     "fmt",
    //     "--stdin"
    // ],
    "go.lintTool": "golangci-lint",
    "go.lintFlags": [
        "--fast",
        "--skip-generated"
    ],
    "gopls": {
        "ui.semanticTokens": true,
        "formatting.gofumpt": true,
        "ui.navigation.importShortcut": "Definition"
    },
    "dotnetAcquisitionExtension.existingDotnetPath": [
        {
            "extensionId": "msazurermtools.azurerm-vscode-tools",
            "path": "/home/bosco/.local/share/mise/installs/dotnet/latest/dotnet"
        },
        {
            "extensionId": "ms-dotnettools.csharp",
            "path": "/home/bosco/.local/share/mise/installs/dotnet/latest/dotnet"
        }
    ],
    "omnisharp.sdkIncludePrereleases": false,
    "csharp.inlayHints.enableInlayHintsForImplicitObjectCreation": true,
    "csharp.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
    "csharp.inlayHints.enableInlayHintsForLambdaParameterTypes": true,
    "csharp.inlayHints.enableInlayHintsForTypes": true,
    "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
    "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
    "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
    "dotnet.inlayHints.enableInlayHintsForOtherParameters": true,
    "dotnet.inlayHints.enableInlayHintsForParameters": true,
    "dotnet.inlayHints.suppressInlayHintsForParametersThatDifferOnlyBySuffix": true,
    "dotnet.inlayHints.suppressInlayHintsForParametersThatMatchArgumentName": true,
    "docomment.syntax": "delimited",
    "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
    "javascript.inlayHints.parameterNames.enabled": "literals",
    "javascript.inlayHints.parameterTypes.enabled": true,
    "javascript.inlayHints.propertyDeclarationTypes.enabled": true,
    "javascript.inlayHints.variableTypes.enabled": true,
    "typescript.inlayHints.variableTypes.enabled": true,
    "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
    "typescript.inlayHints.parameterTypes.enabled": true,
    "typescript.inlayHints.parameterNames.enabled": "literals",
    "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
    "python.languageServer": "Default",
    "python.formatting.autopep8Args": [
        "--max-line-length",
        "90"
    ],
    "python.analysis.indexing": true,
    "python.analysis.importFormat": "absolute",
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.autoIndent": true,
    "python.analysis.completeFunctionParens": false,
    "python.analysis.enablePytestSupport": true,
    "python.analysis.fixAll": [
        "source.convertImportFormat",
        "source.unusedImports"
    ],
    "python.analysis.inlayHints.callArgumentNames": "all",
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.pytestParameters": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.diagnostics.sourceMapsEnabled": true,
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "pythonIndent.trimLinesWithOnlyWhitespace": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": true,
    "python.missingPackage.severity": "Warning",
    "debugpy.debugJustMyCode": false,
    "sql-formatter.dialect": "postgresql",
    "sql-formatter.uppercase": true,
    "sql-formatter.linesBetweenQueries": 2,
    "Prettier-SQL.expressionWidth": 70,
    "Prettier-SQL.keywordCase": "upper",
    "Prettier-SQL.SQLFlavourOverride": "postgresql",
    "Prettier-SQL.commaPosition": "after",
    "Prettier-SQL.ignoreTabSettings": false,
    "Prettier-SQL.linesBetweenQueries": 1,
    "Prettier-SQL.indentStyle": "standard",
    "Prettier-SQL.logicalOperatorNewline": "before",
    "SQL-Formatter-VSCode.dialect": "postgresql",
    "SQL-Formatter-VSCode.expressionWidth": 70,
    "SQL-Formatter-VSCode.keywordCase": "upper",
    "SQL-Formatter-VSCode.dataTypeCase": "upper",
    "SQL-Formatter-VSCode.functionCase": "upper",
    "SQL-Formatter-VSCode.logicalOperatorNewline": "before",
    "SQL-Formatter-VSCode.identifierCase": "preserve",
    "SQL-Formatter-VSCode.indentStyle": "standard",
    "SQL-Formatter-VSCode.ignoreTabSettings": false,
    "sqltools.formatLanguages": [
        "sql"
    ],
    "sqltools.sortColumns": "name",
    "sqltools.format": {
        "language": "sql",
        "indent": "tab",
        "tabSize": 2,
        "linesBetweenQueries": 2,
        "reservedWordCase": "upper"
    },
    "debug.console.acceptSuggestionOnEnter": "on",
    "debug.javascript.autoAttachFilter": "smart",
    "search.exclude": {
        "**/dist": true,
        "**/tmp": true
