#!/usr/bin/env bash
# Register engram with every coding agent detected on this system.
# engram has no auto-discovery, so probe well-known config dirs / binaries and
# run `engram setup <id>` for each agent that is present. Idempotent.
#
# Callers (bootstrap.sh, nix/home/tools.nix activation) are unattended, so every
# `engram setup` call gets stdin from /dev/null (engram only prompts when stdin
# is a TTY) plus a timeout. Agents that engram cannot register without a human
# are reported instead of started, and exit code 10 tells callers that such
# reminders were printed.
set -u

engram="$(command -v engram 2>/dev/null || true)"
if [ -z "$engram" ]; then
	echo "engram not found; install the repository Brewfile then re-run."
	exit 0
fi

# macOS has no coreutils `timeout`; the coreutils formula provides `gtimeout`.
timeout_bin="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"

# `engram setup claude-code` draws a full-screen prompt to add its tools to
# permissions.allow and waits for a keypress. Answering it needs a terminal, and
# a non-interactive run leaves the allowlist empty, so ask the user to run it.
interactive_agents="claude-code"
pending=""

# An interactive setup that already ran leaves a marker in the agent config, so
# the reminder only shows while work is left.
registered() {
	case "$1" in
	claude-code) grep -q 'mcp__engram__' "$HOME/.claude/settings.json" 2>/dev/null ;;
	*) return 1 ;;
	esac
}

setup() {
	case " $interactive_agents " in
	*" $1 "*)
		if registered "$1"; then
			echo "  engram setup $1 (already registered)"
		else
			echo "  engram setup $1 needs a terminal; not started"
			pending="$pending $1"
		fi
		return
		;;
	esac
	status=0
	if [ -n "$timeout_bin" ]; then
		"$timeout_bin" 120 "$engram" setup "$1" >/dev/null 2>&1 </dev/null || status=$?
	else
		"$engram" setup "$1" >/dev/null 2>&1 </dev/null || status=$?
	fi
	case "$status" in
	0) echo "  engram setup $1" ;;
	124)
		echo "  engram setup $1 timed out; not registered"
		pending="$pending $1"
		;;
	*) echo "  engram setup $1 (skipped/failed)" ;;
	esac
}

# probe <engram-id> <binary> [config-dir ...]
# Register the agent if its binary is on PATH, or any config dir (relative to
# $HOME) exists. One line of data per agent instead of a hand-written check.
probe() {
	id="$1" bin="$2"
	shift 2
	for dir in "$@"; do
		[ -d "$HOME/$dir" ] && {
			setup "$id"
			return
		}
	done
	command -v "$bin" >/dev/null 2>&1 && setup "$id"
}

probe claude-code claude .claude
probe cursor cursor .cursor .cursor-server
probe vscode-copilot code .vscode .vscode-server
probe opencode opencode .config/opencode
probe pi pi
probe gemini-cli gemini
probe codex codex
probe windsurf windsurf
probe qwen qwen
probe kiro kiro
probe antigravity-cli antigravity
probe kilocode kilocode

if [ -n "$pending" ]; then
	echo
	echo "engram is not registered with these agents yet. Run each command in a"
	echo "terminal and answer its prompt:"
	for id in $pending; do
		echo "  engram setup $id"
	done
	exit 10
fi

exit 0
