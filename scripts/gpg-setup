#!/usr/bin/env bash
# Optional, interactive GPG setup: link the gpg-agent config and import a key
# for commit signing / SSH auth. Commit signing now uses SSH keys, so this is
# deprecated — run it only if you still need GPG.
#
#   bash ~/dotfiles/scripts/gpg-setup
set -u

REPO="${DOTFILES_REPO:-$HOME/dotfiles}"

append_if_missing() {
	line="$1"
	target_file="$2"
	touch "$target_file"
	grep -Fxq "$line" "$target_file" || printf '%s\n' "$line" >>"$target_file"
}

printf "\n=== GPG Config Setup ===\n"
read -rp "Symlink the gpg-agent config? (y/N): " link_gpg_agent_config
if [ "$link_gpg_agent_config" = "y" ]; then
	mkdir -p "$HOME/.gnupg"
	chmod 700 "$HOME/.gnupg"
	ln -sf "$REPO/gpg-agent.conf" "$HOME/.gnupg/gpg-agent.conf"
fi

printf "\n=== GPG Key Setup ===\n"
read -rp "Import a GPG key now? (y/N): " import_gpg
if [ "$import_gpg" != "y" ]; then
	echo "Skipping. Import later with: gpg --import <path/to/key.asc>"
	exit 0
fi

read -rp "Path to GPG key (.asc file): " gpg_key_path
if [ ! -f "$gpg_key_path" ]; then
	echo "File not found: $gpg_key_path"
	exit 1
fi

gpg --import "$gpg_key_path"
echo "GPG key imported."

read -rp "Email or key ID to trust ultimately: " gpg_email
echo "Setting ultimate trust for $gpg_email..."
echo "If this fails, run: gpg --edit-key $gpg_email, then trust, 5, y, save, quit."
printf 'trust\n5\ny\nsave\n' | gpg --command-fd 0 --edit-key "$gpg_email"

printf "\nListing keys to find the authentication [A] subkey...\n"
gpg --list-keys --with-keygrip "$gpg_email"
read -rp "Keygrip of your authentication subkey: " auth_keygrip
if [ -n "$auth_keygrip" ]; then
	append_if_missing "$auth_keygrip" "$HOME/.gnupg/sshcontrol"
	echo "Authentication subkey added to sshcontrol."

	gpgconf --kill gpg-agent
	gpgconf --launch gpg-agent
	SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
	export SSH_AUTH_SOCK
	printf "\nYour SSH public key (add it to GitHub):\n"
	ssh-add -L
	printf "\nTesting SSH connection to GitHub...\n"
	if ssh -T git@github.com; then
		echo "SSH connection to GitHub successful."
	else
		echo "SSH connection to GitHub failed. Check your key and try again."
	fi
fi
