#!/usr/bin/env bash
# List explicitly installed packages (pacman repos + AUR/foreign via paru) as a
# coloured table: version, source, who installed it, install/update dates and
# description. Origin is inferred from /var/log/pacman.log.
#
# Usage: explicit-packages [view] [-r|--repo] [-a|--aur] [-s|--sort date|updated|name] [-n|--no-color]
#   views: (default) everything not installed by the OS installer
#          -u, --user-typed   only packages you named in a pacman/paru command
#          -i, --installer    only packages the OS installer set up
#          --all              everything, regardless of origin
set -euo pipefail

view=mine source=all sort=date color=1
log=${PACMAN_LOG:-/var/log/pacman.log}
while (($#)); do
	case $1 in
	-u | --user-typed) view=typed ;;
	-i | --installer) view=installer ;;
	--all) view=all ;;
	-r | --repo) source=repo ;;
	-a | --aur) source=aur ;;
	-s | --sort)
		sort=${2:?missing sort key}
		shift
		;;
	-n | --no-color) color=0 ;;
	-h | --help)
		sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	*)
		echo "unknown option: $1" >&2
		exit 1
		;;
	esac
	shift
done
case $sort in date | updated | name) ;; *)
	echo "invalid sort key: $sort" >&2
	exit 1
	;;
esac
[[ -t 1 ]] || color=0
command -v pacman >/dev/null || {
	echo "pacman not found" >&2
	exit 1
}
[[ -r $log ]] || {
	echo "warning: cannot read $log; origin and install dates unavailable" >&2
	log=/dev/null
}

if ((color)); then
	B=$'\e[1m' D=$'\e[2m' R=$'\e[0m' CY=$'\e[36m' GR=$'\e[32m' MA=$'\e[35m' YE=$'\e[33m' BL=$'\e[34m' RE=$'\e[31m'
else
	B= D= R= CY= GR= MA= YE= BL= RE=
fi
cols=$(tput cols 2>/dev/null || echo 120)

# Stream sections into one gawk program, separated by marker lines:
#   foreign packages | installed group members | pacman.log | pacman -Qei
{
	echo '@@FOREIGN'
	pacman -Qqem 2>/dev/null || true
	echo '@@GROUPS'
	pacman -Qg 2>/dev/null || true
	echo '@@LOG'
	cat "$log"
	echo '@@QEI'
	LC_ALL=C pacman -Qei
} | gawk -v view="$view" -v source="$source" -v sort="$sort" -v cols="$cols" \
	-v B="$B" -v D="$D" -v R="$R" -v CY="$CY" -v GR="$GR" -v MA="$MA" -v YE="$YE" -v BL="$BL" -v RE="$RE" '
function logts(s) {  # "2025-12-28T15:20:30+0100" -> epoch (offset ignored)
  return mktime(substr(s,1,4) " " substr(s,6,2) " " substr(s,9,2) " " substr(s,12,2) " " substr(s,15,2) " " substr(s,18,2))
}
function qeits(s,  a) {  # "Sat Nov 14 11:53:33 2026" -> epoch
  split(s, a, /[ :]+/)
  return mktime(a[7] " " mon[a[2]] " " a[3] " " a[4] " " a[5] " " a[6])
}
function pkgname(t) {  # strip repo prefix or package file path/version suffix
  if (t ~ /\.pkg\.tar/) { sub(/.*\//, "", t); sub(/-[^-]+-[^-]+-[^-]+\.pkg\.tar.*$/, "", t) }
  else sub(/^[^\/]+\//, "", t)
  return t
}
# Parse a logged pacman command. Sets op (S/U/R/D/...), asexplicit, alt_root,
# noconfirm, and fills targets[] (count in ntargets).
function parsecmd(cmd,  tok, n, i, t, optarg, endopts) {
  n = split(cmd, tok, / +/); delete targets; ntargets = 0
  op = ""; asexplicit = 0; alt_root = 0; noconfirm = 0; endopts = 0
  for (i = 2; i <= n; i++) {
    t = tok[i]
    if (!endopts && t == "--") { endopts = 1; continue }
    if (!endopts && t ~ /^--/) {
      if (t == "--sync") op = "S"; else if (t == "--upgrade") op = "U"
      else if (t == "--remove") op = "R"; else if (t == "--database") op = "D"
      else if (t == "--asexplicit") asexplicit = 1
      else if (t == "--noconfirm") noconfirm = 1
      else if (t == "--root" || t == "--sysroot") { if (tok[i+1] != "/") alt_root = 1; i++ }
      else if (t ~ /^--(cachedir|config|dbpath|gpgdir|hookdir|logfile|arch|ignore|ignoregroup|overwrite|assume-installed|color|print-format)$/) i++
      continue
    }
    if (!endopts && t ~ /^-[A-Za-z]/) {
      if (match(t, /[DQRSTUFV]/)) op = substr(t, RSTART, 1)
      if (t ~ /^-[a-z]*r$/) { if (tok[i+1] != "/") alt_root = 1; i++ }
      else if (t ~ /^-[a-z]*b$/) i++
      continue
    }
    targets[++ntargets] = pkgname(t)
  }
}
BEGIN {
  split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", m, " ")
  for (i = 1; i <= 12; i++) mon[m[i]] = i
  installer = -1  # -1: no command seen yet; 1: inside installer session; 0: after
}
/^@@/ { sec = $0; next }
sec == "@@FOREIGN" { foreign[$0] = 1; next }
sec == "@@GROUPS"  { groupsof[$2] = groupsof[$2] " " $1; next }
sec == "@@LOG" {
  if ($0 ~ /\[PACMAN\] Running \x27/) {
    ts = logts(substr($1, 2)); cmd = $0
    sub(/^.*Running \x27/, "", cmd); sub(/\x27$/, "", cmd)
    parsecmd(cmd)
    # The installer session starts with a command against an alternate root
    # (Calamares, pacstrap) and continues while commands follow within 5 minutes
    # and look automated (alternate root, --noconfirm, or no targets).
    if (installer == -1) installer = alt_root
    else if (installer == 1 && !(ts - lastcmd <= 300 && (alt_root || noconfirm || ntargets == 0))) installer = 0
    lastcmd = ts
    if (!installer && (op == "S" || op == "U" || (op == "D" && asexplicit)))
      for (i = 1; i <= ntargets; i++) typed[targets[i]] = 1
  } else if (match($0, /\[ALPM\] installed ([^ ]+) /, a)) {
    first[a[1]] = logts(substr($1, 2)); byinst[a[1]] = (installer == 1)
  }
  next
}
sec == "@@QEI" {
  if (match($0, /^([A-Za-z ]+[A-Za-z]) +: (.*)$/, a)) f[a[1]] = a[2]
  else if ($0 == "" && f["Name"] != "") { add(); delete f }
  next
}
END { if (f["Name"] != "") add(); render() }
function add(  n, by, src, ins, upd) {
  n = f["Name"]; upd = qeits(f["Install Date"])
  if (n in first) { ins = first[n]; by = byinst[n] ? "installer" : "indirect" }
  else { ins = upd; by = "unknown" }
  if (by != "installer" && (typed[n] || typedgroup(n))) by = "typed"
  src = (n in foreign) ? "aur" : "repo"
  if (source != "all" && source != src) return
  if (view == "typed" && by != "typed") return
  if (view == "installer" && by != "installer") return
  if (view == "mine" && by == "installer") return
  rows[++nr] = n; ver[n] = f["Version"]; srcof[n] = src; byof[n] = by
  insof[n] = ins; updof[n] = (upd - ins > 60) ? upd : 0; desc[n] = f["Description"]
  count[src]++; count[by]++
}
function typedgroup(n,  gs, i, c) {  # e.g. "pacman -S plasma" types every member
  c = split(groupsof[n], gs, " ")
  for (i = 1; i <= c; i++) if (typed[gs[i]]) return 1
  return 0
}
function key(n) {
  if (sort == "name") return n
  return sprintf("%012d %s", sort == "updated" && updof[n] ? updof[n] : insof[n], n)
}
function render(  i, k, n, wn, wv, wd, d, c, by, tally) {
  for (i = 1; i <= nr; i++) k[i] = key(rows[i]) "\t" rows[i]
  asort(k)
  wn = 7; wv = 7
  for (i = 1; i <= nr; i++) { if (length(rows[i]) > wn) wn = length(rows[i]); if (length(ver[rows[i]]) > wv) wv = length(ver[rows[i]]) }
  wd = cols - (wn + wv + 4 + 9 + 10 + 10 + 12); if (wd < 20) wd = 20
  printf B "%-" wn "s  %-" wv "s  %-4s  %-9s  %-10s  %-10s  %s" R "\n", "PACKAGE", "VERSION", "SRC", "BY", "INSTALLED", "UPDATED", "DESCRIPTION"
  for (i = 1; i <= nr; i++) {
    n = substr(k[i], index(k[i], "\t") + 1); by = byof[n]
    d = desc[n]; if (length(d) > wd) d = substr(d, 1, wd - 1) "…"
    c = by == "typed" ? GR : by == "indirect" ? BL : by == "installer" ? D : RE
    printf CY "%-" wn "s" R "  " YE "%-" wv "s" R "  " (srcof[n] == "aur" ? MA : GR) "%-4s" R "  " c "%-9s" R "  %-10s  " D "%-10s" R "  %s\n", \
      n, ver[n], srcof[n], by, strftime("%Y-%m-%d", insof[n]), updof[n] ? strftime("%Y-%m-%d", updof[n]) : "-", d
    tally[by]++
  }
  printf "\n" B "%d" R " packages: " GR "%d repo" R ", " MA "%d aur/foreign" R " | " GR "%d typed" R ", " BL "%d indirect" R ", " D "%d installer" R ", " RE "%d unknown" R "\n", \
    nr, count["repo"], count["aur"], tally["typed"], tally["indirect"], tally["installer"], tally["unknown"]
}'
