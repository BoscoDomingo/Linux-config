#!/usr/bin/env zsh
# Helper for the zsh Ctrl-R/Up fzf history picker.

emulate -L zsh
setopt extendedglob no_aliases
zmodload zsh/parameter

histfile=${HISTFILE:-$HOME/.histfile}

_load_history_records() {
	_load_raw_records
	_load_decoded_commands
}

# Raw records are only used to rewrite the file on delete. zsh continues an
# entry while a line ends in a backslash, so split records the same way.
_load_raw_records() {
	local line record
	raw_records=()

	[[ -r "$histfile" ]] || return 0
	while IFS= read -r line || [[ -n "$line" ]]; do
		record+="$line"$'\n'
		[[ "$line" == *\\ ]] && continue
		raw_records+=("$record")
		record=
	done <"$histfile"
	[[ -n "$record" ]] && raw_records+=("$record")
}

# The file stores newlines as backslash-newline and non-ASCII bytes metafied,
# so let zsh decode it instead of reading the text as-is.
_load_decoded_commands() {
	local HISTSIZE=$((${#raw_records} + 1)) SAVEHIST=0
	local -a events
	integer event
	decoded_commands=()

	((${#raw_records})) || return 0
	builtin fc -R "$histfile"
	# Key scans of $history skip the current event, which holds the last entry.
	events=(${(on)${(k)history}})
	for ((event = ${events[1]:-HISTCMD}; event <= HISTCMD; event++)); do
		decoded_commands+=("$history[$event]")
	done
}

_list_history() {
	local display
	typeset -A seen
	_load_history_records

	for id in {${#decoded_commands}..1}; do
		[[ -n "${decoded_commands[$id]}" ]] || continue
		((${+seen[${decoded_commands[$id]}]})) && continue
		seen[${decoded_commands[$id]}]=1
		display=${decoded_commands[$id]//$'\n'/\\n}
		display=${display//$'\t'/    }
		printf '%s\t%s\n' "$id" "$display"
	done
}

_show_history() {
	local id=$1
	[[ "$id" == <-> ]] || return 0
	_load_history_records
	printf '%s' "${decoded_commands[$id]}"
}

_pick_history() {
	local query=${1:-} selected id delete_action
	delete_action='execute-silent(zsh-history-fzf delete {1})+reload(zsh-history-fzf list)'

	selected="$(_list_history | fzf \
		--height "${FZF_TMUX_HEIGHT:-40%}" \
		--min-height 20+ \
		-n2..,.. \
		--scheme=history \
		--bind="ctrl-r:toggle-sort,alt-r:toggle-raw,ctrl-d:$delete_action,delete:$delete_action,del:$delete_action,shift-delete:$delete_action" \
		--bind='enter:accept-or-print-query' \
		--header='enter select · ^d/delete remove' \
		--prompt='Global History > ' \
		--with-nth=2.. \
		--wrap-sign=$'\t↳ ' \
		--highlight-line \
		--query="$query")" || return $?

	id=${selected%%$'\t'*}
	if [[ "$id" == <-> ]]; then
		_show_history "$id"
	else
		printf '%s' "$selected"
	fi
}

_delete_history() {
	local id=$1 target tmpfile
	[[ "$id" == <-> ]] || return 0
	_load_history_records
	target=${decoded_commands[$id]}
	[[ -n "$target" ]] || return 0
	# Deletion maps decoded commands back to raw records by position.
	if ((${#decoded_commands} != ${#raw_records})); then
		print -u2 "zsh-history-fzf: $histfile records do not align, not deleting"
		return 1
	fi

	umask 077
	tmpfile=$(mktemp "${TMPDIR:-/tmp}/zsh-history-fzf.XXXXXX") || return 1
	{
		for id in {1..${#decoded_commands}}; do
			[[ "${decoded_commands[$id]}" == "$target" ]] && continue
			printf '%s' "${raw_records[$id]}"
		done
	} >"$tmpfile"
	cat "$tmpfile" >"$histfile"
	rm -f "$tmpfile"
}

case ${1:-list} in
list) _list_history ;;
show) _show_history "${2:-}" ;;
pick) _pick_history "${2:-}" ;;
delete) _delete_history "${2:-}" ;;
*)
	printf 'Usage: %s [list|show ID|pick [QUERY]|delete ID]\n' "$0" >&2
	exit 2
	;;
esac
