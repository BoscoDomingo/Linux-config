{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": "notify",
	"compaction": {
		"auto": true,
		"prune": true,
		"tail_turns": 6
	},
	"default_agent": "collaborative",
	"formatter": true,
	"lsp": true,
	"permission": {
		"bash": {
			"*": "allow",
			"command**": "allow",
			"git commit *": "ask",
			"git commit*": "ask",
			"git diff *": "allow",
			"git push": "ask",
			"git push *": "ask",
			"git push --force *": "ask",
			"git rebase *": "ask",
			"git reset --hard *": "ask",
			"git rm *": "ask",
			"git stash": "ask",
			"git status *": "allow",
			"jj *": "ask",
			"jj bookmark list": "allow",
			"jj bookmark list*": "allow",
			"jj config get": "allow",
			"jj config get*": "allow",
			"jj config list": "allow",
			"jj config list*": "allow",
			"jj config path": "allow",
			"jj config path*": "allow",
			"jj d*": "allow",
			"jj d**": "allow",
			"jj diff": "allow",
			"jj diff*": "allow",
			"jj gf": "allow",
			"jj gf*": "allow",
			"jj git fetch": "allow",
			"jj git fetch*": "allow",
			"jj l*": "allow",
			"jj l**": "allow",
			"jj log": "allow",
			"jj log*": "allow",
			"jj op log": "allow",
			"jj op log*": "allow",
			"jj oplog": "allow",
			"jj oplog*": "allow",
			"jj sh*": "allow",
			"jj sh**": "allow",
			"jj show": "allow",
			"jj show*": "allow",
			"jj st": "allow",
			"jj st*": "allow",
			"jj status": "allow",
			"jj status*": "allow",
			"readlink**": "allow",
			"rg": "allow"
		},
		"edit": "ask",
		"external_directory": {
			"*": "ask",
			".tmp": "allow",
			".tmp/**": "allow",
			"/tmp": "allow",
			"/tmp/**": "allow",
			"~/.config/opencode": "allow",
			"~/.config/opencode/**": "allow"
		},
		"read": {
			"*": "allow",
			"**/*.key": "deny",
			"**/*.pem": "deny",
			"**/.aws/credentials": "deny",
			"**/.config/gh/hosts.yml": "deny",
			"**/.credentials/**": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			"**/.ssh/**": "deny",
			"**/Library/Keychains/**": "deny",
			"**/credentials.json": "deny",
			"**/secrets/**": "deny",
			"*.env": "deny",
			"*.env.*": "deny"
		},
		"webfetch": "ask"
	},
	"plugin": [
		"opencode-devcontainers",
		"envsitter-guard@latest",
		"@mailshieldai/opencode-canvas"
	],
	"reference": {
		"dotfiles": {
			"path": "~/dotfiles"
		},
		"opencode": {
			"repository": "sst/opencode"
		}
	},
	"share": "disabled",
	"shell": "/bin/zsh",
	"snapshot": true,
	"watcher": {
		"ignore": ["node_modules/**", ".git/**", "bun.lock"]
	}
}
